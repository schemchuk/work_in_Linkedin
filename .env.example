# LinkedIn OAuth 2.0 credentials
# Copy this file to .env and fill in your values from https://www.linkedin.com/developers/apps

LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback

# Space-separated list of scopes
# OpenID Connect: openid profile email
# Publish posts: w_member_social
LINKEDIN_SCOPES=openid profile email w_member_social

# Filled automatically by linkedin_auth.py after OAuth authorization
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Claude API key for profile_advisor.py
# Get it from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI key for DALL-E 3 image generation (project_agent.py)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# GitHub owner for project_agent.py (defaults to schemchuk)
GITHUB_OWNER=schemchuk

# Email notifications when the weekly agent fails (Gmail SMTP app password)
NOTIFY_EMAIL_TO=your-email@gmail.com
NOTIFY_EMAIL_FROM=your-gmail@gmail.com
NOTIFY_EMAIL_PASSWORD=your-gmail-app-password
