# LinkedIn OAuth 2.0 credentials
# Copy this file to .env and fill in your values from https://www.linkedin.com/developers/apps

LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback

# Space-separated list of scopes
# OpenID Connect: openid profile email
# Publish posts: w_member_social
LINKEDIN_SCOPES=openid profile email w_member_social

# Filled automatically by linkedin_auth.py after OAuth authorization
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Claude API key for profile_advisor.py
# Get it from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI key for DALL-E 3 image generation (project_agent.py)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# GitHub owner for project_agent.py (defaults to schemchuk)
GITHUB_OWNER=schemchuk

# Email notifications when the weekly agent fails (Gmail SMTP app password)
NOTIFY_EMAIL_TO=your-email@gmail.com
NOTIFY_EMAIL_FROM=your-gmail@gmail.com
NOTIFY_EMAIL_PASSWORD=your-gmail-app-password

# Claude model for the agent and bot (lighter = cheaper)
CLAUDE_MODEL=claude-sonnet-5

# Telegram bot (create via @BotFather; get chat id from /start)
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=

# IMAP for reading LinkedIn notification emails.
# Defaults to NOTIFY_EMAIL_FROM / NOTIFY_EMAIL_PASSWORD if not set —
# override only if LinkedIn notifications arrive at a different Gmail.
LINKEDIN_NOTIF_IMAP_USER=
LINKEDIN_NOTIF_IMAP_PASSWORD=

# Timezone for the bot's daily jobs and inbox poll interval (minutes)
BOT_TZ=Europe/Kyiv
INBOX_POLL_MINUTES=10

# Filled automatically by linkedin_auth.py: token expiry date (YYYY-MM-DD)
# and, if LinkedIn ever grants one, a refresh token for silent renewal
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_REFRESH_TOKEN=

# Minutes between publishing the German and the Ukrainian post versions
POST_GAP_MINUTES=30

# Auto-fix missing LICENSE: when a public repo has no LICENSE, add an MIT
# license and push it directly before deciding whether the repo may be
# linked in a post. Set to false to only block instead of fixing.
AUTO_FIX_LICENSE=true
LICENSE_OWNER=Volodymyr Shemchuk

# OpenAI image model + quality for post images (gpt-image-1/1-mini/1.5/2)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Click-tracked short links for repo links in posts (see link_tracker.py).
# Sign up at https://short.io (free tier), verify a domain (their free
# subdomain works), create an API key under Settings -> Integrations & API.
# Without these, posts fall back to plain GitHub links (no click tracking).
SHORTIO_API_KEY=
SHORTIO_DOMAIN=
